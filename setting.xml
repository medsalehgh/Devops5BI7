<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 https://maven.apache.org/xsd/settings-1.0.0.xsd">
    <servers>
        <server>
            <id>deploymentRepo</id> <!-- Matches the id in your pom.xml -->
            <username>YourUsername</username> <!-- Your Nexus username -->
            <password>YourPassword</password> <!-- Your Nexus password -->
        </server>
        <server>
            <id>snapshotRepo</id> <!-- Matches the id in your pom.xml -->
            <username>YourUsername</username> <!-- Your Nexus username -->
            <password>YourPassword</password> <!-- Your Nexus password -->
        </server>
    </servers>
</settings>
